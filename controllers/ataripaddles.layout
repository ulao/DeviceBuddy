# Simple controller layout file.
# Blocks are separated by a blank line.
# x and y are the center of the shape inside the controller area.
# byte indexes are zero-based: first stream byte is byte 0.

# Analog sticks: up to 8.
# xByte/yByte choose the stream bytes that move the stick.
type: dial
label:  
id:DIAL
x: 110
y: 125
Byte: 10
side: left
shapeType: dial3
 
# Analog sticks: up to 8.
# xByte/yByte choose the stream bytes that move the stick.
type: dial
label:  
id:DIAL
x: 330
y: 40
Byte: 9
side: right
shapeType: dial3

type: button
label: 
id:BTN_1
x: 10
y: 50
byte: 0
bit: 0
group: face
shapeType: circle1


type: button
label: 
id:BTN_1
x: 220
y: 50
byte: 0
bit: 1
group: face
shapeType: circle1
 
 