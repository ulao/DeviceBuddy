﻿# Simple controller layout file.
# Blocks are separated by a blank line.
# x and y are the center of the shape inside the controller area.
# byte indexes are zero-based: first stream byte is byte 0.

# Analog sticks: up to 8.
# xByte/yByte choose the stream bytes that move the stick.
type: analog
label:  
id:LEFTSTICK
x: 75
y: 75
xByte: 3
yByte: 4
side: left
shapeType: circle2

type: analog
label:  
id:RIGHTSTICK
x: 375
y: 75
xByte: 6
yByte: 7
side: right
shapeType: circle2

 

# Face buttons. Max buttons total is 24.
# bit is a bit number, so bit 3 means mask 0x08.
type: button
id:BTN_4
label: 4
x: 300
y: 110
byte: 0
bit: 3
group: face
shapeType: circle1

type: button
id:BTN_2
label: 2
x: 200
y: 110
byte: 0
bit: 1
group: face
shapeType: circle1

type: button
id:BTN_3
label: 3
x: 250
y: 110
byte: 0
bit: 2
group: face
shapeType: circle1

type: button
label: 1
id:BTN_1
x: 150
y: 110
byte: 0
bit: 0
group: face
shapeType: circle1
 
# Analog sticks: up to 8.
# xByte/yByte choose the stream bytes that move the stick.
type: dial
label:  
id:DIAL
x: 400
y: 200
Byte: 3
side: left
shapeType: dial3